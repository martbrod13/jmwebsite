# Skopiuj ten plik jako .env i uzupełnij, kiedy będziesz podłączać prawdziwe usługi.
# Bez pliku .env strona działa w trybie testowym: SMS-y i e-maile trafiają do skrzynki
# testowej w panelu gabinetu i do terminala, nic nie wychodzi na zewnątrz.

# Port serwera (domyślnie 3000)
# PORT=3000

# Adres strony używany w linkach w SMS-ach i e-mailach
# PUBLIC_URL=https://justynamanka.pl

# SMS: outbox (test) albo smsapi
# SMS_DRIVER=smsapi
# SMSAPI_TOKEN=
# SMS_SENDER=JM Beauty

# E-mail: outbox (test) albo resend
# EMAIL_DRIVER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Justyna Mańka Beauty & Aesthetics <kontakt@justynamanka.pl>
# EMAIL_SALON=kontakt@justynamanka.pl

# Hasło startowe do panelu dla kont z config.js (używane tylko przy tworzeniu bazy)
# ADMIN_INITIAL_PASSWORD=
